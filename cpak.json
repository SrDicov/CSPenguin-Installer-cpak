{
  "$schema": "https://raw.githubusercontent.com/Containerpak/cpak/v2/schema/manifest-v3.json",
  "manifest_version": "3.0",
  "name": "CSPenguin Clip Studio Paint",
  "description": "Clip Studio Paint running in a portable cpak environment.",
  "version": "0.1.0",
  "image": "ghcr.io/srdicov/cspenguin-installer-cpak@sha256:cdb57de852ec40e5c86b3626b8079ae84d9b3e9de1eab18929dc5eac13f94d95",
  "runtime_sources": [
    {
      "name": "MicrosoftEdgeWebView2RuntimeInstallerX64.exe",
      "url": "https://msedge.sf.dl.delivery.mp.microsoft.com/filestreamingservice/files/76eb3dc4-7851-45b7-a392-460523b0e2bb/MicrosoftEdgeWebView2RuntimeInstallerX64.exe",
      "sha256": "9f4b90be849ee2fdb1260ff5236bd0faffc5b3e5b48113918ddc6ab031ebbb9e",
      "size": 178042816,
      "installer": "file",
      "destination": "/opt/cspenguin/MicrosoftEdgeWebView2RuntimeInstallerX64.exe"
    }
  ],
  "binaries": [
    "/usr/local/bin/cspenguin-cpak",
    "/usr/local/bin/cspenguin-studio-cpak"
  ],
  "desktop_entries": [
    "/usr/share/applications/com.cspenguin.ClipStudioPaint.desktop",
    "/usr/share/applications/com.cspenguin.ClipStudio.desktop"
  ],
  "form_factors": [
    "desktop"
  ],
  "idle_time": 0,
  "override": {
    "displayX11": true,
    "clipboard": {
      "hostToApp": true,
      "appToHost": true
    },
    "socketPulseAudio": true,
    "deviceDri": true,
    "deviceShm": true,
    "deviceInput": true,
    "deviceUsb": true,
    "filePicker": {
      "openFile": true,
      "openFolder": true,
      "saveFile": true,
      "persistent": true,
      "containingFolder": true
    },
    "filesystem": [
      {
        "path": "home",
        "access": "read-write"
      }
    ],
    "network": true,
    "openURI": true,
    "notification": true,
    "env": []
  }
}
